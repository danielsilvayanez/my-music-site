---
// Header - Navigation bar
// ------------
// Description: A navigation component that offers a persistent and convenient way to switch between primary destinations in an app.
// Properties:
// - type: The navigation bar behavior (optional, enum: 'none' | 'sticky', default: 'sticky')
//
// Structure:
// - Menu toggle: Mobile menu toggle button for responsive navigation
// - Navigation Links: Primary navigation menu items
// - Theme Switcher: Light/dark mode toggle switch
// Reference: https://wind-ui.com/components/navbars/

// Content
// - Components
// - UI
// - Props
type Props = {
	type?: 'none' | 'sticky'
}
// -- Page Metadata
const { type = 'sticky' } = Astro.props

// - Data
// Import navigation data from JSON file
import navigationData from '../../data/json-files/navigationBarData.json'
// Get the current page path
const path = new URL(Astro.request.url).pathname
// Define types for navigation items and categories
type NavType = 'home'
// Initialize default navigation type
const navType: NavType = 'home'
// Get the navigation items for the current category
const navItems = navigationData[navType]
// Helper function to determine if a navigation item is active
function isActivePath(currentPath: string): boolean {
	return path === currentPath || path === `${currentPath}/`
}
---

<header class:list={['header', { [`header--${type}`]: type }]}>
	<div class="header__container">
		<nav aria-label="main navigation" role="navigation" class="header__nav">
			{/* Menu toggle - Mobile only */}
			<button
				id="mobile-menu-toggle"
				class="mobile-menu-toggle"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Toggle navigation"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>

			{/* Desktop Navigation */}
			<div class="desktop-nav">
				<ul>
					{
						navItems.map((item) => (
							<li>
								<a
									href={item.link}
									class={`nav-link ${isActivePath(item.link) ? 'active' : ''}`}
								>
									{item.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</nav>
	</div>

	{/* Mobile Menu Overlay */}
	<div id="mobile-menu" class="mobile-menu">
		<div class="mobile-menu-content">
			<ul>
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.link}
								class={`mobile-nav-link ${isActivePath(item.link) ? 'active' : ''}`}
							>
								{item.name}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</header>

<style>
	/* Header */
	.header {
		@apply sticky top-0 z-20 w-full bg-white dark:bg-neutral-950;
	}
	.header__container {
		@apply relative w-full px-6;
	}
	.header__nav {
		@apply flex h-[5.5rem] w-full items-center justify-end gap-6;
	}

	/* Mobile Menu Toggle Button */
	.mobile-menu-toggle {
		position: relative;
		width: 40px;
		height: 40px;
		background: none;
		border: none;
		cursor: pointer;
		z-index: 1000;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
		padding: 8px;
	}
	.mobile-menu-toggle span {
		display: block;
		width: 100%;
		height: 2px;
		background: #262626;
		transition: all 0.3s;
	}
	.mobile-menu-toggle.active span:nth-child(1) {
		transform: rotate(45deg) translate(7px, 7px);
	}
	.mobile-menu-toggle.active span:nth-child(2) {
		opacity: 0;
	}
	.mobile-menu-toggle.active span:nth-child(3) {
		transform: rotate(-45deg) translate(7px, -7px);
	}
	:global(.dark) .mobile-menu-toggle span {
		background: #fff;
	}

	/* Mobile Menu Overlay */
	.mobile-menu {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		background: white;
		z-index: 999;
		transform: translateX(-100%);
		transition: transform 0.3s ease;
	}
	.mobile-menu.open {
		transform: translateX(0);
	}
	.mobile-menu:not(.open) {
		visibility: hidden;
	}
	:global(.dark) .mobile-menu {
		background: #0a0a0a;
	}
	.mobile-menu-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		height: 100%;
		padding: 2rem;
	}
	.mobile-menu ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		text-align: center;
	}
	.mobile-nav-link {
		font-size: 2rem;
		font-weight: 500;
		color: #262626;
		text-decoration: none;
		transition: color 0.3s;
	}
	.mobile-nav-link:hover,
	.mobile-nav-link.active {
		color: #ffdf20;
	}
	:global(.dark) .mobile-nav-link {
		color: #fff;
	}
	:global(.dark) .mobile-nav-link:hover,
	:global(.dark) .mobile-nav-link.active {
		color: #8c55fd;
	}

	/* Desktop Navigation */
	.desktop-nav ul {
		display: flex;
		gap: 2rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.desktop-nav {
		display: none;
	}
	.nav-link {
		font-size: 1rem;
		font-weight: 500;
		color: #262626;
		text-decoration: none;
		transition: color 0.3s;
	}
	.nav-link:hover,
	.nav-link.active {
		color: #ffdf20;
	}
	.mobile-menu-toggle:focus-visible,
	.nav-link:focus-visible,
	.mobile-nav-link:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 4px;
	}
	:global(.dark) .nav-link {
		color: #fff;
	}
	:global(.dark) .nav-link:hover,
	:global(.dark) .nav-link.active {
		color: #8c55fd;
	}
	@media (min-width: 768px) {
		.mobile-menu-toggle,
		.mobile-menu {
			display: none;
		}
		.desktop-nav {
			display: block;
		}
		.desktop-nav ul {
			align-items: center;
			gap: clamp(1.25rem, 2.5vw, 2.5rem);
		}
	}
	@media (max-width: 767px) {
		.desktop-nav {
			display: none;
		}
		.mobile-menu-toggle {
			display: flex;
		}
		.mobile-menu {
			display: block;
		}
	}
</style>
