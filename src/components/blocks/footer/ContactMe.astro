---
// Contact Me
// ------------
// Description: A component that displays a contact me section with a title, first column, and second column.
---

<footer id="contact" class="footer" aria-labelledby="footer-title">
	<div class="footer__container">
		<div class="footer__row">
			<div class="footer__col col-span-2 row-span-2 hidden 2xl:block"></div>
			<div class="footer__col col-span-4 lg:col-span-12 2xl:col-span-5">
				<h2 id="footer-title" class="animate z-10 text-6xl font-normal not-italic lg:text-9xl">
					Lust auf <br />Live-Musik?
				</h2>
			</div>
			<div class="footer__col col-span-4 lg:col-span-12 2xl:col-span-5">
				<p class="font-headings animate text-lg leading-8 text-neutral-500">
					Deine Veranstaltung braucht Musik? Ich bin nur eine Mail entfernt:
					<a class="text-neutral-800 dark:text-white" href="mailto:daniel.silva-yanez@gmx.de">
						daniel.silva-yanez@gmx.de
					</a>
					Du kannst mich auch auf Instagram finden unter <a
						class="text-neutral-800 dark:text-white"
						href="https://www.instagram.com/daniel_silva_yanez/"
					>
						Auf Instagram schreiben
					</a>.
				</p>
			</div>
		</div>
	</div>

	<style>
		.footer {
			@apply relative flex items-end py-20 text-neutral-600 lg:py-32 dark:text-neutral-400;
		}
		.footer__container {
			@apply container relative z-[1] mx-auto px-6;
		}
		.footer__row {
			@apply grid grid-cols-4 justify-end gap-9 lg:grid-cols-12;
		}
		.footer__col {
			@apply relative self-end;
		}
		.footer__links {
			@apply flex flex-col gap-1 text-lg leading-8 text-neutral-600 dark:text-neutral-300 [&_a]:text-neutral-600 [&_a]:transition-colors [&_a]:duration-300 dark:[&_a]:text-neutral-300;
		}
		.footer__link {
			@apply flex items-center gap-2;
		}
	</style>
</footer>
