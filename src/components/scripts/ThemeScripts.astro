<!-- Homepage editorial motion -->
<script>
	const initHomepageMotion = () => {
		const homepage = document.querySelector<HTMLElement>('.homepage')
		if (!homepage) return
		if (homepage.dataset.motionInitialized === 'true') return

		const motionItems = homepage.querySelectorAll<HTMLElement>('[data-motion]')
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			motionItems.forEach((item) => item.classList.add('is-visible'))
			homepage.dataset.motionInitialized = 'true'
			return
		}
		if (!('IntersectionObserver' in window)) return

		homepage.dataset.motionInitialized = 'true'
		homepage.classList.add('motion-enabled')

		const observer = new IntersectionObserver(
			(entries, currentObserver) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return
					entry.target.classList.add('is-visible')
					currentObserver.unobserve(entry.target)
				})
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
		)

		const revealVisibleItems = () => {
			motionItems.forEach((item) => {
				const bounds = item.getBoundingClientRect()
				if (bounds.bottom <= 0 || bounds.top >= window.innerHeight) return
				item.classList.add('is-visible')
				observer.unobserve(item)
			})
		}

		motionItems.forEach((item) => observer.observe(item))
		requestAnimationFrame(revealVisibleItems)
		window.setTimeout(() => {
			motionItems
				.forEach((item) => {
					if (item.dataset.motion === 'section-heading') item.classList.add('is-visible')
				})
		}, 1200)
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initHomepageMotion)
	} else {
		initHomepageMotion()
	}
	document.addEventListener('astro:page-loaded', initHomepageMotion)
</script>

<!-- Mobile Menu Toggle -->
<script>
	function initMobileMenu() {
		const toggle = document.getElementById('mobile-menu-toggle')
		const menu = document.getElementById('mobile-menu')
		const menuLinks = document.querySelectorAll('.mobile-nav-link')

		if (!toggle || !menu) return
		let previouslyFocused: HTMLElement | null = null
		const closeMenu = () => {
			menu.classList.remove('open')
			toggle.classList.remove('active')
			toggle.setAttribute('aria-expanded', 'false')
			if (previouslyFocused) previouslyFocused.focus()
		}

		// Toggle menu
		toggle.addEventListener('click', () => {
			const isOpen = menu.classList.contains('open')
			if (isOpen) {
				closeMenu()
			} else {
				previouslyFocused = document.activeElement as HTMLElement | null
				menu.classList.add('open')
				toggle.classList.add('active')
				toggle.setAttribute('aria-expanded', 'true')
				;(menuLinks[0] as HTMLElement | undefined)?.focus()
			}
		})
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.classList.contains('open')) closeMenu()
		})

		// Close menu when link is clicked
		menuLinks.forEach((link) => {
			link.addEventListener('click', () => {
				closeMenu()
			})
		})
	}

	// Initialize
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMobileMenu)
	} else {
		initMobileMenu()
	}
</script>
