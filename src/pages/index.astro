---
import Layout from '../layouts/LayoutDesign.astro'
import Section from '../components/ui/Section.astro'
import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'

import Feed from '../components/ui/Feeds/ExperienceFeed.astro'
import Slider from '../components/ui/Slider.astro'
import Testimonial from '../components/ui/Testimonial.astro'

import experienceData from '../data/json-files/experienceData.json'
import testimonialData from '../data/json-files/testimonialData.json'

// Load settings
import siteSettings from '../data/json-files/site-settings.json'
const { seo, hero } = siteSettings
---

<Layout title={seo.title} description={seo.description} navigation="sticky">
	<!-- Intro -->
	<Section id="intro" classes="!overflow-visible !pt-40 lg:!pt-28">
		<Row>
			<Col span="2" />
			<Col span="10" spanMobile="4">
				{
					hero.type === 'image' ? (
						<img
							src={hero.imageSrc}
							alt={hero.imageAlt}
							width="500"
							height="500"
							class="animate absolute -left-40 -top-32 size-80 rounded-full object-cover object-top md:-left-72 md:-top-24 md:size-[31.25rem]"
							loading="eager"
							fetchpriority="high"
						/>
					) : (
						<img
							src={hero.imageSrc}
							alt={hero.imageAlt}
							width="500"
							height="500"
							class="animate absolute -left-40 -top-32 size-80 rounded-full object-cover object-top md:-left-72 md:-top-24 md:size-[31.25rem]"
							loading="eager"
							fetchpriority="high"
						/>
						// <video
						// 	autoplay
						// 	muted
						// 	poster={hero.videoPoster}
						// 	class="animate absolute -left-40 -top-56 size-80 rounded-full object-cover md:-left-72 md:-top-44 md:size-[31.25rem]"
						// >
						// 	<source src={hero.videoSrc} type="video/mp4" />
						// </video>
					)
				}

				<div class="animate relative z-10">
					<h1 class="max-w-3xl font-normal">
						Hi, <br />I’m Daniel <br />& I ❤️ music.
					</h1>

					<ul class="font-headings flex flex-wrap gap-6 text-lg italic lg:gap-9">
						<li class="animate">
							<a class="text-inherit" href="mailto:daniel.silva-yanez@gmx.de"
								>daniel.silva-yanez@gmx.de</a
							>
						</li>
						<li class="animate">
							<a class="text-inherit" href="tel:+4917649166600">017649166600</a>
						</li>
						<li class="animate">
							<a class="text-inherit" href="https://www.instagram.com/daniel_silva_yanez/"
								>@daniel_silva_yanez</a
							>
						</li>
					</ul>
				</div>
			</Col>
		</Row>
	</Section>

	<!-- About -->
	<Section id="about" classes="!pt-8 text-left">
		<div class="mx-auto mb-10 max-w-5xl">
			<!-- Videokarte: clean, ohne laute Muster, mit subtiler Tiefe -->
			<div
				class="relative aspect-video w-full overflow-hidden rounded-3xl bg-neutral-900 shadow-2xl ring-1 ring-black/10"
			>
				<div
					class="pointer-events-none absolute inset-0 rounded-3xl bg-gradient-to-t from-black/10 to-transparent"
				>
				</div>
				<iframe
					class="h-full w-full rounded-3xl"
					src="https://www.youtube.com/embed/zWmXhgImSQ8"
					title="YouTube video player"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen></iframe>
			</div>
		</div>

		<!-- Text: bessere Zeilenlänge + Spalten erst ab lg -->
		<div class="mx-auto max-w-4xl text-left lg:gap-10">
			<p class="mb-6 break-inside-avoid text-balance leading-relaxed lg:mb-0">
				Musik hat mein Leben verändert - auch wenn ich sie erst später so richtig für mich entdeckt
				habe. Mit der Gitarre fing alles an, bald kamen Gesang und Keyboard dazu. Vieles habe ich
				mir selbst beigebracht, manches im Unterricht verfeinert. Doch am Ende war es vor allem
				Fleiß, Ausdauer und unzählige Stunden Übung, die mich musikalisch weitergebracht haben.
				Dabei gehört auch Mut dazu: Mut, Fehler zu machen, ins kalte Wasser zu springen und niemals
				aufzugeben, wenn etwas nicht sofort klappt. Genau das macht für mich den Weg in der Musik so
				wertvoll. Auf der Bühne zu stehen – ob mit Bands, in Chören, bei Musicals oder als
				Entertainer – hat mir gezeigt, was Musik bewirken kann. Sie schafft Verbindung zwischen
				Menschen, reißt uns aus dem Alltag heraus und macht jeden Moment einzigartig. Für mich ist
				Musik eine Sprache, die alle verstehen. Und genau diese Sprache möchte ich nutzen, um Herzen
				zu berühren und unvergessliche Augenblicke zu schaffen.
			</p>
		</div>
	</Section>

	<!-- Experience -->
	<Section id="experience" classes="!overflow-visible">
		<Row>
			<Col span="2" spanMobile="4" classes="h-full">
				<h2 class="sticky top-4 pr-2 lg:pr-0 lg:text-right">Experience</h2>
			</Col>
			<Col span="10" spanMobile="4">
				<div class="space-y-8">
					<!-- optional: zarter Divider oben für Rhythmus -->
					<div class="h-px bg-neutral-200/60"></div>
					<Feed data={experienceData} />
					<!-- zarter Divider unten, hält die Sektion zusammen -->
					<div class="h-px bg-neutral-200/60"></div>
				</div>
			</Col>
		</Row>
	</Section>

	<!-- Skills & Tools -->
	<Section id="skills">
		<Row>
			<Col span="2" spanMobile="4">
				<h2 class="lg:text-right">Skills & Tools</h2>
			</Col>
			<Col span="10" spanMobile="4">
				<div class="space-y-8">
					<!-- Optional: divider for visual rhythm -->
					<div class="h-px bg-neutral-200/60"></div>

					<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
						<!-- Linke Spalte: Künstlerische Fähigkeiten -->
						<ul class="list-outside list-disc space-y-2 pl-5">
							<li>Live-Gesang (Genres: Rock, Pop, Musical, Schlager, Disney, Rap)</li>
							<li>Bühnenerfahrung Solist: 2 Jahre im Center Parcs als Entertainer/Sänger</li>
							<li>Soft Skills: Emotion, Energie, Publikumsnähe, Moderation, Tanz/Schauspiel</li>
						</ul>
						<!-- Rechte Spalte: Technik & Tools -->
						<ul class="list-outside list-disc space-y-2 pl-5">
							<li>Technik & Tools: HK Polar 12 Mk2 PA und Sennheiser Mikrofon/e</li>
							<li>Fortbildung zum Vocal Coach: POWERVOICE (2025–2026)</li>
							<li>Perspektive: Vocal Coaching anbieten</li>
						</ul>
					</div>

					<!-- Optional: divider at the bottom -->
					<div class="h-px bg-neutral-200/60"></div>
				</div>
			</Col>
		</Row>
	</Section>

	<!-- Feedback -->
	<Section id="feedback">
		<Row>
			<Col span="2" spanMobile="4"><h2 class="lg:text-right">Feedback (Spaß)</h2></Col>
			<Col span="10" spanMobile="4">
				<Slider
					slidesPerView={1}
					id="feedbackSlider"
					delay={3500}
					showNavigation={false}
					showPagination={false}
					centeredSlides={true}
					initialSlide={0}
				>
					{
						testimonialData.map((item: any) => (
							<div class="swiper-slide">
								<Testimonial
									blockquote={item.blockquote}
									figcaption={item.figcaption}
									cite={item.cite}
									align="left"
									quoteClasses="font-headings italic"
								/>
							</div>
						))
					}
				</Slider>
			</Col>
		</Row>
	</Section>

	<!-- Sound Samples -->
	<Section id="sound-samples">
		<Row>
			<Col span="2" spanMobile="4">
				<h2 class="lg:text-right">Sound Samples</h2>
			</Col>
			<Col span="10" spanMobile="4">
				<div class="space-y-8">
					<!-- Optional: divider for visual rhythm -->
					<div class="h-px bg-neutral-200/60"></div>

					<div class="prose prose-lg max-w-none dark:prose-invert">
						<p class="text-balance leading-relaxed">
							Hier findest du bald Hörproben von meinen Live-Auftritten und Studio-Aufnahmen. Lass
							dich von verschiedenen Genres und Stilen inspirieren und höre, wie ich Musik zum Leben
							erwecke.
						</p>

						<div
							class="mt-8 rounded-2xl border-2 border-dashed border-neutral-300 bg-neutral-50 p-12 text-center dark:border-neutral-700 dark:bg-neutral-900"
						>
							<p class="mb-4 text-lg font-medium text-neutral-600 dark:text-neutral-400">
								Hörproben kommen bald!
							</p>
							<p class="text-sm text-neutral-500 dark:text-neutral-500">
								Ich arbeite gerade daran, dir hier ausgewählte Sound-Samples zur Verfügung zu
								stellen. Schau bald wieder vorbei oder kontaktiere mich direkt für Referenzen.
							</p>
						</div>
					</div>

					<!-- Optional: divider at the bottom -->
					<div class="h-px bg-neutral-200/60"></div>
				</div>
			</Col>
		</Row>
	</Section>

	<!-- Prices -->
	<Section id="prices">
		<Row>
			<Col span="2" spanMobile="4">
				<h2 class="lg:text-right">Prices</h2>
			</Col>
			<Col span="10" spanMobile="4">
				<div class="space-y-8">
					<!-- Optional: divider for visual rhythm -->
					<div class="h-px bg-neutral-200/60"></div>

					<div class="prose prose-lg max-w-none dark:prose-invert">
						<p class="text-balance leading-relaxed">
							Jeder Auftritt ist einzigartig – und genau das sollten auch die Konditionen sein. Ob
							Firmenfeier, Hochzeit, Geburtstag oder ein anderes Event: Ich erstelle dir gerne ein
							individuelles Angebot, das genau auf deine Wünsche und Rahmenbedingungen zugeschnitten
							ist.
						</p>

						<h3 class="mt-8 text-xl font-semibold">Was beeinflusst den Preis?</h3>
						<ul class="list-outside list-disc space-y-2 pl-5">
							<li>
								<strong>Art der Veranstaltung</strong> – Private Feier, Firmenevent, Hochzeit etc.
							</li>
							<li>
								<strong>Dauer des Auftritts</strong> – Von 30 Minuten bis zu mehreren Stunden
							</li>
							<li>
								<strong>Ort & Anfahrt</strong> – Entfernung und Erreichbarkeit des Veranstaltungsortes
							</li>
							<li>
								<strong>Technische Ausstattung</strong> – Nutze ich meine eigene Technik oder ist vor
								Ort alles vorhanden?
							</li>
							<li>
								<strong>Spezielle Wünsche</strong> – Bestimmte Songs, Setlisten, musikalische Schwerpunkte,
								einen, oder mehrere Künstler
							</li>
						</ul>

						<h3 class="mt-8 text-xl font-semibold">Interessiert?</h3>
						<p class="text-balance leading-relaxed">
							Schreib mir einfach unten eine Nachricht mit ein paar Eckdaten zu deinem Event, und
							ich melde mich schnellstmöglich mit einem unverbindlichen Angebot bei dir. Gemeinsam
							finden wir die perfekte Lösung für deinen unvergesslichen Auftritt!
						</p>
					</div>

					<!-- Optional: divider at the bottom -->
					<div class="h-px bg-neutral-200/60"></div>
				</div>
			</Col>
		</Row>
	</Section>
</Layout>
