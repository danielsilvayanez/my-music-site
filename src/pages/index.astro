---
import Layout from '../layouts/LayoutDesign.astro'
import InstagramEmbed from '../components/ui/InstagramEmbed.astro'
import siteSettings from '../data/json-files/site-settings.json'
const { seo } = siteSettings
---

<Layout title={seo.title} description={seo.description} navigation="sticky">
	<div class="homepage">
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero__media" aria-hidden="true">
				<img src="/media/relaunch/f9197805-126f-496a-a013-29ff4c99662f.JPG" alt="" width="3072" height="4096" fetchpriority="high" />
			</div>
			<div class="hero__content container">
				<p class="eyebrow">Live · Entertainment · Deutschlandweit</p><h1 id="hero-title">
					Live-Musik,<br /><em>die dein Event</em><br />mitreißt.
				</h1><p class="hero__intro">
					Ich bin Daniel Silva Yañez – Sänger und Entertainer für private Feiern, Corporate Events,
					Bars, Restaurants und besondere Anlässe.
				</p><div class="hero__meta">
					<span>Pop · Rock · Musical · Party-Klassiker</span><span
						>Deutsch · Englisch · Spanisch</span>
				</div><div class="hero__actions">
					<a class="button button--primary" href="#anfragen">Event anfragen <span>↗</span></a><a
						class="button button--text"
						href="#live">Live erleben <span>↓</span></a>
				</div>
			</div>
			<p class="hero__scroll" aria-hidden="true">Weiter entdecken <span>↓</span></p>
		</section>

		<section id="live" class="section section--live container" aria-labelledby="live-title">
			<div class="section__intro">
				<p class="eyebrow">Live erleben</p><h2 id="live-title">
					So klingt ein Abend<br /><em>mit mir.</em>
				</h2><p>Echte Auftritte, echte Stimmung, echtes Publikum.</p>
			</div><InstagramEmbed
				class="media-placeholder--reel"
				url="https://www.instagram.com/p/DcbslsRK2r_/"
				title="Live-Auftritt von Daniel Silva Yañez"
			/><div class="section__meta">
				<span>Pop · Rock · Musical · Party</span><span>Deutsch · Englisch · Spanisch</span><span
					>Deutschlandweit buchbar</span>
			</div>
		</section>

		<section id="events" class="section section--events container" aria-labelledby="events-title">
			<p class="eyebrow">Für jeden Anlass</p><h2 id="events-title">
				Für Events, die mehr als<br /><em>Hintergrundmusik</em> brauchen.
			</h2><p class="section__lead">
				Ob private Feier, Firmenveranstaltung oder Abendprogramm – ich passe Setlist, Stimmung und
				Ablauf an den jeweiligen Anlass an.
			</p><div class="event-list">
				<div><span>01</span><h3>Private Feiern & Geburtstage</h3></div><div>
					<span>02</span><h3>Corporate Events & Firmenfeiern</h3>
				</div><div><span>03</span><h3>Bars, Restaurants & Hotels</h3></div><div>
					<span>04</span><h3>Weihnachtsfeiern</h3>
				</div>
			</div><aside class="event-note">
				<strong>Hochzeit oder Trauung geplant?</strong><span
					>Auf Anfrage sind auch Duo-Auftritte möglich.</span>
			</aside>
		</section>

		<section class="section section--statement" aria-labelledby="statement-title">
			<div class="statement__image">
				<img
					src="/media/relaunch/9e29d5b7-3b17-4099-acb5-5c2e48c39e37.JPG"
					alt="Daniel Silva Yañez als Sänger"
					width="484"
					height="415"
					loading="lazy"
				/>
			</div><div class="statement__content">
				<p class="eyebrow">Meine Haltung auf der Bühne</p><h2 id="statement-title">
					Nicht nur singen.<br /><em>Menschen mitnehmen.</em>
				</h2><p>
					Für mich geht es bei einem Auftritt nicht nur darum, Songs sauber zu performen. Ich möchte
					Atmosphäre schaffen, auf das Publikum reagieren und dafür sorgen, dass aus einem
					Programmpunkt ein echter Moment wird.
				</p><div class="statement__themes">
					<div>
						<strong>Publikumsnähe</strong><span
							>Ich lese den Raum und gehe auf die Stimmung vor Ort ein.</span>
					</div><div>
						<strong>Entertainment</strong><span
							>Ein Auftritt darf Energie haben, überraschen und Menschen zusammenbringen.</span>
					</div><div>
						<strong>Musikalische Vielfalt</strong><span
							>Von Balladen bis Party-Klassikern – passend zur Dynamik des Abends.</span>
					</div>
				</div>
			</div>
		</section>

		<section id="repertoire" class="section section--range container" aria-labelledby="range-title">
			<div>
				<p class="eyebrow">Musikalische Bandbreite</p><h2 id="range-title">
					Von Gänsehaut<br /><em>bis Mitsingen.</em>
				</h2>
			</div><div class="range__copy">
				<p>
					Mein Repertoire reicht von ruhigen Balladen bis zu energiegeladenen Party-Klassikern – mit
					Songs aus mehreren Jahrzehnten und in mehreren Sprachen.
				</p><div class="range__words">
					<span>Pop</span><span>Rock</span><span>Musical</span><span>Balladen</span><span
						>Party-Klassiker</span
					><span>80er</span><span>90er</span><span>2000er</span><span>aktuelle Songs</span>
				</div><p class="small">
					Die Auswahl passe ich an Anlass, Publikum und gewünschte Stimmung an.
				</p>
			</div>
		</section>

		<section class="section section--formats container" aria-labelledby="formats-title">
			<p class="eyebrow">Flexible Setups</p><h2 id="formats-title">
				So kann dein Event<br /><em>klingen.</em>
			</h2><p class="section__lead">
				Je nach Anlass kann ich flexibel in unterschiedlichen Setups auftreten.
			</p><div class="format-list">
				<article>
					<span>01 / Standard</span><h3>Solo mit Instrumental-Playbacks</h3><p>
						Mein Standard-Setup für private Feiern, Firmenveranstaltungen, Bars und ähnliche Events.
					</p>
				</article><article>
					<span>02 / Akustisch</span><h3>Mit Gitarre und/oder Piano</h3><p>
						Für einen akustischeren, persönlicheren oder ruhigeren Rahmen ist auf Wunsch eine
						instrumentale Begleitung möglich.
					</p>
				</article><article>
					<span>03 / Auf Anfrage</span><h3>Duo für besondere Anlässe</h3><p>
						Für Hochzeiten oder Trauungen sind auf Anfrage auch Duo-Auftritte möglich.
					</p>
				</article>
			</div><p class="small">
				Dauer, Besetzung und Ablauf stimmen wir individuell auf dein Event ab.
			</p>
		</section>

		<section class="section section--gallery container" aria-labelledby="gallery-title">
			<div class="gallery__heading">
				<p class="eyebrow">Eindrücke</p><h2 id="gallery-title">
					Live. Echt.<br /><em>Mittendrin.</em>
				</h2><p>Ein paar Eindrücke von Auftritten, Bühnenmomenten und Abenden mit Publikum.</p>
			</div><div class="gallery__images">
				<InstagramEmbed
					url="https://www.instagram.com/p/DcbslsRK2r_/"
					title="Live-Auftritt von Daniel Silva Yañez"
				/><InstagramEmbed
					url="https://www.instagram.com/p/DdBOLOCqnum/"
					title="Live-Auftritt von Daniel Silva Yañez"
				/><InstagramEmbed
					url="https://www.instagram.com/p/DcmSWqUKY6q/"
					title="Performance von Daniel Silva Yañez"
				/><InstagramEmbed
					url="https://www.instagram.com/p/DY2W3M_qdgv/"
					title="Musikvideo von Daniel Silva Yañez"
				/>
			</div>
		</section>

		<section id="about" class="section section--about container" aria-labelledby="about-title">
			<div>
				<p class="eyebrow">Über mich</p><h2 id="about-title">
					Bühne ist für mich<br /><em>mehr als ein Auftritt.</em>
				</h2>
			</div><div>
				<p>
					Musik hat mein Leben verändert. Mit der Gitarre fing alles an, später kamen Gesang und
					Keyboard dazu. Auf der Bühne – ob mit Bands, in Chören, bei Musicals oder als Entertainer
					– habe ich gelernt, wie Musik Menschen verbindet.
				</p><p>
					Diese Erfahrung und meine Beschäftigung mit Stimme und Bühnenpräsenz bringe ich in jeden
					Auftritt ein.
				</p>
			</div>
		</section>

		<section class="section section--process container" aria-labelledby="process-title">
			<p class="eyebrow">Der Weg zu deinem Event</p><h2 id="process-title">
				So einfach<br /><em>geht’s.</em>
			</h2><div class="process-list">
				<div>
					<span>01</span><h3>Anfrage senden</h3><p>
						Schreib mir per E-Mail oder Instagram mit Datum, Ort und ein paar Infos zu deinem Event.
					</p>
				</div><div>
					<span>02</span><h3>Details abstimmen</h3><p>
						Wir klären Dauer, gewünschte Stimmung, musikalische Ausrichtung und das passende Setup.
					</p>
				</div><div>
					<span>03</span><h3>Individuelles Angebot erhalten</h3><p>
						Du bekommst ein passendes Angebot – abhängig von Event, Dauer, Besetzung und Anfahrt.
					</p>
				</div>
			</div>
		</section>

		<section id="anfragen" class="section section--cta" aria-labelledby="cta-title">
			<div class="container">
				<p class="eyebrow">Lass uns loslegen</p><h2 id="cta-title">
					Lust auf Live-Musik,<br /><em>die dein Event mitnimmt?</em>
				</h2><p>
					Erzähl mir kurz, was du planst – ich melde mich mit einem passenden Vorschlag für Ablauf,
					Setup und Auftrittsdauer.
				</p><div class="cta__actions">
					<a class="button button--primary" href="mailto:daniel.silva-yanez@gmx.de"
						>Event anfragen <span>↗</span></a
					><a class="button button--outline" href="https://www.instagram.com/daniel_silva_yanez/"
						>Auf Instagram schreiben <span>↗</span></a>
				</div><p class="small">Deutschlandweit buchbar · Deutsch · Englisch · Spanisch</p>
			</div>
		</section>
	</div>
</Layout>

<style>
	:global(body) {
		background: #11100f;
		color: #e9e4dc;
	}
	:global(.header) {
		background: rgba(17, 16, 15, 0.88);
		color: #e9e4dc;
		backdrop-filter: blur(14px);
	}
	:global(.nav-link) {
		color: #e9e4dc !important;
	}
	.homepage {
		background: #11100f;
		color: #e9e4dc;
		overflow: hidden;
	}
	.homepage h2,
	.homepage h3 {
		color: #f2eee8;
	}
	.homepage > .section:not(.section--events):not(.section--cta) p:not(.eyebrow):not(.small) {
		color: #d8d1c8;
	}
	.container {
		width: min(100% - 3rem, 80rem);
		margin-inline: auto;
	}
	.hero {
		min-height: min(56rem, 100svh);
		position: relative;
		display: grid;
		align-items: center;
		overflow: hidden;
		isolation: isolate;
	}
	.hero__media {
		position: absolute;
		inset: 0;
		z-index: -2;
		background: #24201c;
	}
	.hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 68% center;
		opacity: 0.62;
		filter: saturate(0.8) contrast(1.05);
	}
	.hero__media::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, #11100f 0%, rgba(17, 16, 15, 0.9) 32%, rgba(17, 16, 15, 0.3) 72%, rgba(17, 16, 15, 0.48) 100%),
			linear-gradient(0deg, #11100f 0%, rgba(17, 16, 15, 0.15) 44%, rgba(17, 16, 15, 0.55) 100%);
	}
	.hero__content {
		padding-block: 7rem 5rem;
	}
	.eyebrow {
		color: #f28b3d;
		font:
			600 0.7rem/1.2 ui-sans-serif,
			system-ui,
			sans-serif;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	h1,
	h2,
	h3,
	p {
		margin: 0;
	}
	h1,
	h2,
	h3 {
		font-family: ui-sans-serif, system-ui, sans-serif;
		letter-spacing: -0.055em;
	}
	h1 {
		max-width: 55rem;
		margin: 1.5rem 0 2rem;
		font-size: clamp(3.4rem, 9vw, 8rem);
		line-height: 0.88;
		font-weight: 700;
	}
	.hero h1 {
		color: #f2eee8;
	}
	h2 {
		font-size: clamp(2.8rem, 6vw, 6rem);
		line-height: 0.92;
		font-weight: 700;
	}
	h3 {
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		line-height: 1.05;
	}
	em {
		color: #f28b3d;
		font-style: normal;
	}
	p {
		font:
			400 1.1rem/1.65 ui-sans-serif,
			system-ui,
			sans-serif;
		color: #bcb4aa;
	}
	.hero__intro {
		max-width: 38rem;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		color: #f5f0e8;
	}
	.hero__meta,
	.section__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 2rem;
		margin-top: 2rem;
		color: #e9e4dc;
		font:
			600 0.75rem/1.4 ui-sans-serif,
			system-ui,
			sans-serif;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.hero__actions,
	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2.5rem;
	}
	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		min-height: 3.25rem;
		padding: 0.8rem 1.25rem;
		border: 1px solid transparent;
		color: #11100f;
		font:
			700 0.8rem ui-sans-serif,
			system-ui,
			sans-serif;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}
	.button:hover {
		transform: translateY(-2px);
	}
	.button--primary {
		background: #f28b3d;
	}
	.button--text {
		color: #e9e4dc;
	}
	.button--outline {
		border-color: #71685e;
		color: #e9e4dc;
	}
	.hero__scroll {
		position: absolute;
		right: 3rem;
		bottom: 2rem;
		display: flex;
		gap: 0.7rem;
		color: #e9e4dc;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.section {
		padding-block: clamp(5rem, 11vw, 10rem);
	}
	.section__intro {
		max-width: 44rem;
	}
	.section__intro p:last-child {
		margin-top: 1.5rem;
	}
	.section--live {
		display: grid;
		grid-template-columns: 1fr minmax(14rem, 25rem);
		gap: 3rem 10%;
		align-items: end;
	}
	.section--live h2 {
		color: #f2eee8;
	}
	.section--live .section__intro > p:last-child {
		color: #d8d1c8;
	}
	.section--live .section__meta {
		grid-column: 1 / -1;
		margin-top: 0;
	}
	.media-placeholder {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 28rem;
		overflow: hidden;
		background: linear-gradient(135deg, #33261d, #171514);
		border: 1px solid #4b382a;
	}
	.media-placeholder--reel {
		aspect-ratio: 9 / 16;
		min-height: 0;
		grid-column: 2;
		grid-row: 1 / span 2;
	}
	.media-placeholder--small {
		min-height: 15rem;
	}
	.media-placeholder::before {
		content: '';
		position: absolute;
		inset: 12%;
		border: 1px solid rgba(242, 139, 61, 0.35);
		transform: rotate(-8deg);
	}
	.media-placeholder__play {
		position: relative;
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		border: 1px solid #f28b3d;
		border-radius: 50%;
		color: #f28b3d;
		font-size: 1.25rem;
	}
	.media-placeholder__label {
		position: absolute;
		left: 1rem;
		bottom: 1rem;
		color: #e9e4dc;
		font:
			600 0.65rem ui-sans-serif,
			system-ui,
			sans-serif;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.section--events {
		background: #f0ebe3;
		color: #171514;
		width: 100%;
		max-width: none;
		padding-inline: max(1.5rem, calc((100% - 80rem) / 2));
	}
	.section--events p,
	.section--events .small {
		color: #645b52;
	}
	.section--events h2 {
		margin-top: 1.5rem;
	}
	.section--events h2,
	.section--events h3 {
		color: #171514;
	}
	.section__lead {
		max-width: 40rem;
		margin-top: 1.5rem;
	}
	.event-list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		margin-top: 5rem;
		border-top: 1px solid #c8bcae;
	}
	.event-list div {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: 1rem;
		align-items: baseline;
		padding: 1.5rem 0;
		border-bottom: 1px solid #c8bcae;
	}
	.event-list span,
	.process-list span,
	.format-list span {
		color: #f28b3d;
		font:
			700 0.7rem ui-monospace,
			monospace;
		letter-spacing: 0.1em;
	}
	.event-note {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		margin-top: 2rem;
		padding-left: 3rem;
		font:
			0.85rem ui-sans-serif,
			system-ui,
			sans-serif;
	}
	.event-note span {
		color: #645b52;
	}
	.section--statement {
		display: grid;
		grid-template-columns: minmax(15rem, 1fr) minmax(20rem, 1fr);
		gap: clamp(2rem, 8vw, 8rem);
		width: min(100% - 3rem, 100rem);
	}
	.statement__image img {
		width: 100%;
		height: 100%;
		max-height: 42rem;
		object-fit: cover;
		filter: saturate(0.65);
	}
	.statement__content > p {
		max-width: 38rem;
		margin-top: 1.5rem;
	}
	.section--statement h2 {
		color: #f2eee8;
	}
	.section--statement .statement__content > p:not(.eyebrow) {
		color: #d8d1c8;
	}
	.statement__themes {
		margin-top: 3rem;
		border-top: 1px solid #403933;
	}
	.statement__themes div {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid #403933;
	}
	.statement__themes strong {
		color: #e9e4dc;
		font:
			600 0.9rem ui-sans-serif,
			system-ui,
			sans-serif;
	}
	.statement__themes span {
		color: #9d958b;
		font:
			0.9rem/1.5 ui-sans-serif,
			system-ui,
			sans-serif;
	}
	.section--range {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
	}
	.range__copy {
		padding-top: 3rem;
	}
	.range__words {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 2rem 0;
	}
	.range__words span {
		padding: 0.6rem 0.8rem;
		border: 1px solid #51443a;
		color: #e9e4dc;
		font:
			0.8rem ui-sans-serif,
			system-ui,
			sans-serif;
	}
	.section--formats {
		border-top: 1px solid #403933;
	}
	.section--formats .section__lead {
		margin-bottom: 3rem;
	}
	.format-list,
	.process-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}
	.format-list article,
	.process-list div {
		padding: 1.5rem;
		border: 1px solid #403933;
	}
	.format-list h3,
	.process-list h3 {
		margin: 3rem 0 1rem;
	}
	.format-list p,
	.process-list p {
		font-size: 0.95rem;
	}
	.section--gallery {
		display: grid;
		grid-template-columns: 0.75fr 1.25fr;
		gap: 4rem;
	}
	.gallery__heading p:last-child {
		margin-top: 1.5rem;
	}
	.gallery__images {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		align-items: stretch;
	}
	.gallery__images > .instagram-embed {
		aspect-ratio: 4 / 5;
	}
	.section--about {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		border-top: 1px solid #403933;
	}
	.section--about > div:last-child {
		padding-top: 3rem;
	}
	.section--about p + p {
		margin-top: 1.5rem;
	}
	.section--process {
		border-top: 1px solid #403933;
	}
	.process-list {
		margin-top: 4rem;
	}
	.section--cta {
		background: #f28b3d;
		color: #171514;
	}
	.section--cta h2 {
		margin-top: 1.5rem;
